---
import Entry from '../components/Entry.astro';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { visibleProjects } from '../data/projects';
import { upstream, visibleUpstream } from '../data/upstream';

const fmt = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const when = (d: string) => fmt.format(new Date(d));
const repoUrl = (r: string) => `${site.github}/${r}`;
---

<Base>
  <a class="skip" href="#log">Skip to projects</a>
  <header class="bar">
    <nav aria-label="Primary">
      <a href="#log">projects</a>
      <a href="#contact">contact</a>
      <a href={site.blog}>blog</a>
      <a href={site.github}>github</a>
      {/* the pet on the line: graph.ts shows this (it is hidden without the script) and puts the pet's face in it */}
      <button class="theme pet" type="button" aria-label="Switch pet" data-pet-toggle hidden></button>
      <button class="theme" type="button" aria-label="Toggle colour theme" data-theme-toggle>
        <span aria-hidden="true">◐</span>
      </button>
    </nav>
  </header>

  <div class="tree" data-tree data-layout="branches">
    <svg class="tree-svg" aria-hidden="true" focusable="false"></svg>

    <section class="hero" id="top">
      {/* the command is typed by src/scripts/intro.ts on a first visit; the visible copy is decoration, the
           screen-reader copy is read once */}
      <p class="eyebrow">
        <span class="sr-only">~/sheltoncyril $ git log --graph</span>
        <span aria-hidden="true">~/sheltoncyril <span class="prompt">$</span> <span class="cmd"><span data-typed></span><span class="cursor"></span><span data-rest>git log --graph</span></span></span>
      </p>
      <h1 class="name" data-name><a href="#top"><span>Shelton</span> <span>Cyril</span></a></h1>
      <div class="name-slot" data-name-slot aria-hidden="true"></div>
      <div class="trace" data-trace></div>
      <p class="role">{site.role}</p>
      <p class="intro">{site.intro}</p>
    </section>

    <section class="fork" aria-label="Branches">
      <div class="fork-labels" aria-hidden="true">
        <span class="lane-pill hw"><i></i>hardware</span>
        <span class="lane-pill sw"><i></i>software</span>
        {visibleUpstream.length > 0 && <span class="lane-pill rh"><i></i>upstream</span>}
      </div>
      <div class="fork-tools">
        <span class="mono muted">layout</span>
        <div class="toggle" role="group" aria-label="Graph layout">
          <button type="button" data-set-layout="branches" aria-pressed="true">branches</button>
          <button type="button" data-set-layout="lanes" aria-pressed="false">lanes</button>
        </div>
      </div>
    </section>

    <ol class="log" id="log" aria-label="Projects, newest first">
      {
        visibleProjects.map((p) => (
          <Entry
            kind={p.lane === 'hardware' ? 'hw' : 'sw'}
            label={p.lane}
            title={p.title}
            summary={p.summary}
            tags={p.tags}
            status={p.status}
            image={p.image}
            imageAlt={p.imageAlt}
            links={[
              ...(p.repo ? [{ label: 'source', href: repoUrl(p.repo) }] : []),
              ...(p.live ? [{ label: 'live', href: p.live }] : []),
            ]}
            metaDate={`started ${when(p.started)}`}
            metaDateTime={p.started}
            metaRef={`${p.lane === 'hardware' ? 'hw' : 'sw'}/${p.id}`}
          />
        ))
      }
    </ol>

    {
      visibleUpstream.length > 0 && (
        <>
          <section class="upstream-head" data-upstream-head>
            <div class="upstream-copy">
              <p class="mono rh-text">git checkout -b upstream/redhat software</p>
              <h2>{upstream.title}</h2>
              <p>{upstream.blurb}</p>
            </div>
          </section>
          <ol class="log upstream-log" aria-label="Open-source work at Red Hat">
            {visibleUpstream.map((u) => (
              <Entry
                kind="rh"
                label="upstream"
                title={u.title}
                summary={u.summary}
                tags={u.tags}
                links={[
                  { label: 'my pull requests', href: `https://github.com/${u.repo}/pulls?q=is%3Apr+author%3A${site.githubUser}` },
                  { label: 'project', href: `https://github.com/${u.repo}` },
                ]}
                metaDate={u.span}
                metaRef={u.repo}
              />
            ))}
          </ol>
        </>
      )
    }

    <section class="merge" aria-hidden="true">
      <span class="mono muted">git merge hardware software</span>
    </section>

    <section class="outro" id="contact">
      <span class="anchor head-anchor" aria-hidden="true"></span>
      <p class="mono muted">HEAD → main</p>
      <h2>Say hello.</h2>
      <p>
        More lives on <a href={site.github}>GitHub</a> and the <a href={site.blog}>blog</a>.
        {site.email && <>Or write to <a href={`mailto:${site.email}`}>{site.email}</a>.</>}
      </p>
      <p class="fine mono muted">© {new Date().getFullYear()} {site.name}</p>
    </section>
  </div>

  <script>
    import '../scripts/graph';
  </script>
</Base>
