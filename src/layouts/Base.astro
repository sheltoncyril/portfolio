---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif';
// candidates for the name; the page switches between them with ?font= (see graph.ts)
import '@fontsource/dm-serif-display/latin-400.css';
import '@fontsource/dm-serif-display/latin-400-italic.css';
import '@fontsource/gloock/latin-400.css';
import '@fontsource/young-serif/latin-400.css';
import '../styles/global.css';
import { site } from '../data/site';

const url = `https://${site.domain}/`;
const og = new URL('og.png', url).href;
const sameAs = [site.github, site.blog, site.linkedin].filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url,
  sameAs,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name} — software &amp; hardware</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0c0d0e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${site.name} — software & hardware`} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Set the theme before first paint to avoid a flash.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
      document.documentElement.classList.add('js');
      // Shell-style start (src/scripts/intro.ts): decide before first paint whether the page plays its intro
      // (the class `sh` hides the parts that print after the typed command). Same rules as shouldRun() there:
      // not with reduced motion, ?intro=0, a #hash, a reload or back/forward navigation, or a second visit in
      // this tab's session; ?intro=1 forces it. The watchdog drops the class if the script never takes over.
      try {
        var h = document.documentElement, s = location.search;
        if (!/[?&]intro=0\b/.test(s) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          var seen = false;
          try { seen = sessionStorage.getItem('intro-seen') === '1'; } catch (e) {}
          var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
          var restored = nav && (nav.type === 'reload' || nav.type === 'back_forward'); // scroll gets restored
          if (/[?&]intro=1\b/.test(s) || (!seen && !restored && !location.hash && !(window.scrollY > 4))) {
            h.classList.add('sh');
            window.__shWatch = setTimeout(function () { h.classList.remove('sh'); }, 5000);
          }
        }
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
